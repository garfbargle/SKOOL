{
  "name": "skool",
  "version": "1.0.0",
  "description": "A standards-aligned curriculum studio for teachers and parents.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run validate && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name skool --branch main --commit-dirty=true",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "validate": "node --experimental-strip-types scripts/validate-content.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.120.0"
  },
  "private": true
}